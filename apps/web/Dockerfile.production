# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Production image for the Interscale Travel CRM web SPA, served by Nginx.
#
# Build from the REPOSITORY ROOT (the build context must include packages/ and
# apps/), e.g.:
#   docker buildx build --platform linux/amd64 -f apps/web/Dockerfile.production \
#     --build-arg VITE_API_URL=/api -t interscale-web-prod .
#
# The frontend calls the API through a same-origin relative `/api` path, so
# only the allowlisted public build variable below is passed in. No root .env
# is copied into the context and no server secrets are baked in.
# ---------------------------------------------------------------------------

# ---- builder: compile the static bundle ------------------------------------
FROM node:20-bookworm-slim AS builder
WORKDIR /app
# `npm ci` installs every workspace, including the API's native modules
# (argon2), so the builder needs a toolchain even though the web runtime does
# not. These tools live only in this discarded build stage.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Public build-time configuration only (never secrets).
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY packages/ packages/
COPY apps/web/ apps/web/
COPY tsconfig.base.json ./
RUN npm run build:shared && npm run build:web
# Do not ship source maps in the production image (they expose source).
RUN find apps/web/dist -name '*.map' -delete

# ---- runtime: non-root nginx on port 8080 ----------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080
